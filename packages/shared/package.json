{
  "private": true,
  "type": "module",
  "name": "shared",
  "exports": {
    ".": {
      "types": "./dist/src/index.d.ts",
      "default": "./dist/src/index.js"
    },
    "./src/index": {
      "types": "./dist/src/index.d.ts",
      "default": "./dist/src/index.js"
    },
    "./src/prisma": {
      "types": "./dist/src/prisma.d.ts",
      "default": "./dist/src/prisma.js"
    },
    "./src/schema": {
      "types": "./dist/src/schema.d.ts",
      "default": "./dist/src/schema.js"
    }
  },
  "scripts": {
    "compile": "tsp compile .",
    "format-tsp": "tsp format \"**/*.tsp\"",
    "preopenapi-ts": "npm run compile",
    "openapi-ts": "openapi-typescript ./tsp-output/schema/openapi.yaml --output ./src/generated/schema.ts",
    "prebuild": "concurrently \"npm run openapi-ts\" \"npm run db-generate\"",
    "build": "tsc --build tsconfig.json",
    "db-generate": "prisma generate",
    "db-migrate": "./bin/env.sh prisma migrate dev",
    "db-migrate:deploy": "prisma migrate deploy",
    "format-db": "prisma format",
    "test": "",
    "typecheck-bin": "tsc --noEmit -p tsconfig.bin.json",
    "preformat": "npm run format-tsp && npm run format-db",
    "format": "vp fmt package.json src bin test --write",
    "format-check": "vp fmt package.json src bin test --check",
    "lint": "npm run compile && vp lint src bin test && node --experimental-strip-types ./bin/check-missing-4xx-responses.ts",
    "lint-fix": "vp lint src bin test --fix"
  },
  "devDependencies": {
    "@types/node": "^25.9.5",
    "@typespec/compiler": "^1.15.0",
    "@typespec/http": "^1.15.0",
    "@typespec/openapi": "^1.15.0",
    "@typespec/openapi3": "^1.15.0",
    "@typespec/rest": "^0.80.0",
    "concurrently": "^9.2.4",
    "openapi-typescript": "^7.9.1",
    "typescript": "^6.0.3"
  },
  "dependencies": {
    "@prisma/adapter-pg": "^7.9.1",
    "@prisma/client": "^7.9.1",
    "prisma": "^7.9.1"
  },
  "optionalDependencies": {
    "@rollup/rollup-linux-x64-gnu": "^4.62.4"
  }
}

{
  "private": true,
  "type": "module",
  "name": "task",
  "scripts": {
    "build": "tsc --build tsconfig.json",
    "predev-migrate": "npm run build",
    "dev-migrate": "./bin/env.sh node dist/src/index.js migrate",
    "predev-hello": "npm run build",
    "dev-hello": "./bin/env.sh node dist/src/index.js hello",
    "tsc": "tsc --build tsconfig.test.json",
    "vitest": "vp test --config=./vite.config.ts",
    "test": "concurrently \"npm run tsc\" \"npm run vitest\"",
    "test-ci": "vp test run --config=./vite.config.ts --maxWorkers=1",
    "format": "vp fmt package.json src bin --write",
    "format-check": "vp fmt package.json src bin --check",
    "lint": "vp lint src bin",
    "lint-fix": "vp lint src bin --fix"
  },
  "dependencies": {
    "@prisma/adapter-pg": "^7.9.1"
  },
  "devDependencies": {
    "@types/node": "^26.2.0",
    "concurrently": "^9.2.4",
    "typescript": "^7.0.2"
  }
}
